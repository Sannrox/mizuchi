# MERGE INTO: match, update, insert, and delete unmatched target rows.

statement ok
CREATE TABLE t (id INT, v INT)

statement ok
INSERT INTO t VALUES (1, 10), (2, 20), (4, 40)

statement ok
CREATE TABLE s (id INT, v INT)

statement ok
INSERT INTO s VALUES (2, 99), (3, 30)

statement ok
MERGE INTO t USING s ON t.id = s.id
WHEN MATCHED THEN UPDATE SET v = s.v
WHEN NOT MATCHED THEN INSERT (id, v) VALUES (s.id, s.v)

query II rowsort
SELECT id, v FROM t
----
1
10
2
99
3
30
4
40

statement ok
CREATE TABLE t2 (id INT, v INT)

statement ok
INSERT INTO t2 VALUES (1, 10), (2, 20)

statement ok
CREATE TABLE s2 (id INT, v INT)

statement ok
INSERT INTO s2 VALUES (2, 99)

statement ok
MERGE INTO t2 USING s2 ON t2.id = s2.id
WHEN MATCHED THEN UPDATE SET v = s2.v
WHEN NOT MATCHED BY SOURCE THEN DELETE

query II rowsort
SELECT id, v FROM t2
----
2
99

# INSERT * takes every target column from the source by name, and fails when
# the source lacks one instead of inserting NULL.
statement ok
CREATE TABLE ti (id INT, v INT)

statement ok
CREATE TABLE si (id INT, v INT)

statement ok
INSERT INTO si VALUES (1, 10)

statement ok
CREATE TABLE sn (id INT)

statement ok
INSERT INTO sn VALUES (2)

statement ok
MERGE INTO ti USING si ON ti.id = si.id WHEN NOT MATCHED THEN INSERT *

query II
SELECT id, v FROM ti
----
1
10

statement error
MERGE INTO ti USING sn ON ti.id = sn.id WHEN NOT MATCHED THEN INSERT *

query II
SELECT id, v FROM ti
----
1
10

# An ON without equality keys matches each target row against every source row.

statement ok
CREATE TABLE tr (id INT, v INT)

statement ok
INSERT INTO tr VALUES (1, 10), (5, 50), (9, 90)

statement ok
CREATE TABLE sr (lo INT, hi INT, v INT)

statement ok
INSERT INTO sr VALUES (0, 3, 11), (4, 6, 55), (20, 30, 0)

statement ok
MERGE INTO tr USING sr ON tr.id >= sr.lo AND tr.id <= sr.hi
WHEN MATCHED THEN UPDATE SET v = sr.v
WHEN NOT MATCHED THEN INSERT (id, v) VALUES (sr.lo, sr.v)
WHEN NOT MATCHED BY SOURCE THEN DELETE

query II rowsort
SELECT id, v FROM tr
----
1
11
20
0
5
55

# An equality key with a residual condition checks the residual per candidate.

statement ok
CREATE TABLE tq (id INT, v INT)

statement ok
INSERT INTO tq VALUES (1, 10), (2, 20)

statement ok
CREATE TABLE sq (id INT, v INT)

statement ok
INSERT INTO sq VALUES (1, 5), (1, 15), (2, 1)

statement ok
MERGE INTO tq USING sq ON tq.id = sq.id AND sq.v > tq.v
WHEN MATCHED THEN UPDATE SET v = sq.v

query II rowsort
SELECT id, v FROM tq
----
1
15
2
20
