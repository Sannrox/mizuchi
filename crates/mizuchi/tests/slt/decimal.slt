# DECIMAL. CAST of integer/float/text executes. DECIMAL SQL types and
# arithmetic fail closed (NotImplemented SQL type). Arrow Decimal* is accepted
# at the schema boundary (see schema unit tests).

query T
SELECT CAST(1 AS TEXT)
----
1

query I
SELECT CAST(1 AS BIGINT)
----
1

query R
SELECT CAST(1.5 AS DOUBLE PRECISION)
----
1.5

skipif mizuchi
query R
SELECT CAST(1 AS DECIMAL(10, 2))
----
1.00

skipif mizuchi
query R
SELECT CAST('1.50' AS DECIMAL(10, 2)) + CAST('2.25' AS DECIMAL(10, 2))
----
3.75

skipif mizuchi
query R
SELECT CAST(CAST(3 AS DECIMAL(10, 2)) AS DOUBLE PRECISION)
----
3
