# DECIMAL. CAST of integer/float/text and DECIMAL/NUMERIC (Arrow Decimal*)
# execute. Overflow and precision above 38 fail closed.

query T
SELECT CAST(1 AS TEXT)
----
1

query I
SELECT CAST(1 AS BIGINT)
----
1

query R
SELECT CAST(1.5 AS DOUBLE PRECISION)
----
1.5

query R
SELECT CAST(1 AS DECIMAL(10, 2))
----
1.00

query R
SELECT CAST('1.50' AS DECIMAL(10, 2)) + CAST('2.25' AS DECIMAL(10, 2))
----
3.75

query R
SELECT CAST(CAST(3 AS DECIMAL(10, 2)) AS DOUBLE PRECISION)
----
3

query R
SELECT CAST('999.9' AS DECIMAL(4, 1)) * CAST('999.9' AS DECIMAL(4, 1))
----
999800.01
