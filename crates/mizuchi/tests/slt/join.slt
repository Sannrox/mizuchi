# Join kinds the binder accepts. Null keys never match.
# t.a: 1, 2, 2, 3, NULL. u.id: 2, 2, 4, NULL.

statement ok
CREATE TABLE t (a INTEGER)

statement ok
INSERT INTO t VALUES (1), (2), (2), (3), (NULL)

statement ok
CREATE TABLE u (id INTEGER, x INTEGER)

statement ok
INSERT INTO u VALUES (2, 10), (2, 30), (4, 40), (NULL, 99)

# Inner join: two left 2s × two right 2s → four rows of (2, 2).
query II rowsort
SELECT t.a, u.id FROM t JOIN u ON t.a = u.id
----
2
2
2
2
2
2
2
2

query II rowsort
SELECT t.a, u.id FROM t INNER JOIN u ON t.a = u.id
----
2
2
2
2
2
2
2
2

# Left: unmatched left keys (1, 3, NULL) pad the right side.
query II rowsort
SELECT t.a, u.id FROM t LEFT JOIN u ON t.a = u.id
----
1
NULL
2
2
2
2
2
2
2
2
3
NULL
NULL
NULL

# Right: unmatched right keys (4, NULL) pad the left side.
query II rowsort
SELECT t.a, u.id FROM t RIGHT JOIN u ON t.a = u.id
----
2
2
2
2
2
2
2
2
NULL
4
NULL
NULL

# Full: unmatched rows from both sides.
query II rowsort
SELECT t.a, u.id FROM t FULL OUTER JOIN u ON t.a = u.id
----
1
NULL
2
2
2
2
2
2
2
2
3
NULL
NULL
4
