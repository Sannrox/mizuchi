# Semi: left rows that match at least once (the two 2s).
query I rowsort
SELECT t.a FROM t LEFT SEMI JOIN u ON t.a = u.id
----
2
2

# Anti: left rows that never match (1, 3, NULL).
query I rowsort
SELECT t.a FROM t LEFT ANTI JOIN u ON t.a = u.id
----
1
3
NULL
