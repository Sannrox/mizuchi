# Scalar function families: string, math, conditional, array.

statement ok
CREATE TABLE t (a INTEGER, b TEXT)

statement ok
INSERT INTO t VALUES (-4, ' Ab '), (9, 'xy'), (NULL, NULL)

query I
SELECT abs(a) FROM t WHERE a IS NOT NULL ORDER BY 1
----
4
9

query R
SELECT ceil(1.1)
----
2

query R
SELECT floor(1.9)
----
1

query R
SELECT round(1.5)
----
2

query R
SELECT sqrt(9)
----
3

query I
SELECT length('é')
----
1

query T
SELECT trim('  x ')
----
x

query T
SELECT ltrim('  x')
----
x

query T
SELECT rtrim('x  ')
----
x

query T
SELECT upper(b) FROM t WHERE a = 9
----
XY

query T
SELECT concat(b, '!') FROM t WHERE a = 9
----
xy!

query I
SELECT nullif(1, 1)
----
NULL

query I
SELECT nullif(1, 2)
----
1

query I
SELECT coalesce(a, 7) FROM t WHERE a IS NULL
----
7

query I
SELECT array_length(ARRAY[1, 2, 3], 1)
----
3

query I
SELECT abs(a) FROM t WHERE a IS NULL
----
NULL

# CASE and COALESCE evaluate a branch only on the rows that select it, so a
# guarded error does not fire.
statement ok
CREATE TABLE g (x INTEGER)

statement ok
INSERT INTO g VALUES (0), (2), (NULL), (4)

query II
SELECT x, CASE WHEN x = 0 THEN 0 ELSE 8 / x END FROM g ORDER BY x NULLS LAST
----
0
0
2
4
4
2
NULL
NULL

query I
SELECT coalesce(x, 1 / 0) FROM g WHERE x IS NOT NULL ORDER BY 1
----
0
2
4

query II
SELECT x, CASE WHEN x IS NULL THEN -1 ELSE CASE WHEN x = 0 THEN 0 ELSE 8 / x END END FROM g ORDER BY x NULLS LAST
----
0
0
2
4
4
2
NULL
-1

query II
SELECT x, CASE x WHEN 0 THEN 100 WHEN 2 THEN 8 / x END FROM g ORDER BY x NULLS LAST
----
0
100
2
4
4
NULL
NULL
NULL

query II
SELECT x, coalesce(NULL, x, 9) FROM g ORDER BY x NULLS LAST
----
0
0
2
2
4
4
NULL
9

statement error
SELECT CASE WHEN x = 2 THEN 1 / 0 ELSE 1 END FROM g

# SUBSTRING counts characters, and positions before 1 use up the length.
query T
SELECT substring('abcdef' FROM 1 FOR 3)
----
abc

query T
SELECT substring('abcdef' FROM 3)
----
cdef

query T
SELECT substring('abc' FROM 0 FOR 2)
----
a

query T
SELECT substring('abc' FROM -1 FOR 3)
----
a

query T
SELECT concat('<', substring('abc' FROM -5 FOR 3), '>')
----
<>

query T
SELECT substring('abc' FROM -1)
----
abc

query T
SELECT concat('<', substring('abc' FROM 5 FOR 2), '>')
----
<>

query T
SELECT concat('<', substring('abc' FROM 4), '>')
----
<>

query T
SELECT substring('ä€😀x' FROM 2 FOR 2)
----
€😀

query T
SELECT substring('ä€😀x' FROM 3)
----
😀x

statement error
SELECT substring('abc' FROM 1 FOR -1)
