# Subqueries: derived tables, IN lists, IN (SELECT), EXISTS, scalar, LATERAL.

statement ok
CREATE TABLE t (a INTEGER, b TEXT)

statement ok
INSERT INTO t VALUES (1, 'x'), (2, 'y'), (3, 'z'), (NULL, 'n')

query I
SELECT a FROM (SELECT a FROM t) s WHERE a IS NOT NULL
----
1
2
3

query I
SELECT a FROM t WHERE a IN (1, 2)
----
1
2

query I
SELECT a FROM t WHERE a IN (SELECT a FROM t)
----
1
2
3

query I
SELECT a FROM t WHERE EXISTS (SELECT 1 FROM t u WHERE u.a = t.a)
----
1
2
3

query I
SELECT (SELECT a FROM t WHERE a = 1)
----
1

query I
SELECT a FROM t WHERE a NOT IN (SELECT a FROM t)
----

query I
SELECT a FROM t WHERE 99 NOT IN (SELECT a FROM t)
----

query I
SELECT a FROM t WHERE EXISTS (SELECT 1 FROM t LIMIT 0)
----

query II
SELECT (SELECT a FROM t WHERE a = 1) AS x, a FROM t WHERE a IS NOT NULL
----
1
1
1
2
1
3

query I
SELECT a FROM t WHERE EXISTS (SELECT 1 FROM t u WHERE u.a = CAST(t.a AS BIGINT))
----
1
2
3

query I
SELECT a FROM t, LATERAL (SELECT a AS x) s WHERE t.a = s.x
----
1
2
3
