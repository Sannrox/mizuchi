# DATE, TIMESTAMP, and INTERVAL. Schema accepts those Arrow types; SQL casts
# and functions bind onto them. CURRENT_DATE / NOW() use the runner clock
# pinned to 2020-01-01 00:00:00 UTC.

query T
SELECT CAST('2020-01-01' AS DATE)
----
2020-01-01

query T
SELECT CAST('2020-01-01 00:00:00' AS TIMESTAMP)
----
2020-01-01 00:00:00

query T
SELECT INTERVAL '1' DAY
----
1 day

query I
SELECT EXTRACT(YEAR FROM DATE '2020-01-01')
----
2020

query T
SELECT DATE_TRUNC('day', TIMESTAMP '2020-01-02 15:04:05')
----
2020-01-02 00:00:00

query T
SELECT CURRENT_DATE
----
2020-01-01

query T
SELECT NOW()
----
2020-01-01 00:00:00
